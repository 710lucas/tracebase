# Copy to `.env` and adjust. Load it with: node --env-file=.env src/main.ts

# Port the API (and the built front end) listens on. Default: 3333.
PORT=3333

# Memgraph connection. When unset, the API keeps the graph in memory (lost on restart).
MEMGRAPH_URL=bolt://localhost:7687

# Only for a Memgraph that asks for credentials; leave commented out otherwise.
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=

# Only for `npm run web:dev`: where the Vite dev server forwards the API paths.
# API_ADDRESS=http://localhost:3333
